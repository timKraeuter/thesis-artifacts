target TypeScript

main reactor Crossing {  // Import and/or declare reactor classes.
    ctl = new CarTrafficLight()  // Instantiate reactors. Connect ports.
    ptl = new PedestrianTrafficLight()
    ctl.notify -> ptl.notify
}

reactor CarTrafficLight {
    output notify: number  // 0 --> red 1 --> red-amber 2 --> green 3 --> amber
    state currentState: number = 0

    reaction(startup) {=
        console.log("Car traffic light is red.");
    =}
    timer changeState(1 s, 2 s);
    reaction(changeState) -> notify {=
        console.log("");
        if (currentState === 0) {
            console.log("Car traffic light switches to red-amber!");
            currentState = 1;
            return;
        }
        if (currentState === 1) {
            console.log("Car traffic light switches to green!");
            currentState = 2;
            notify = 0; // Tell pedestrian light to switch to red.
            return;
        }
        if (currentState === 2) {
            console.log("Car traffic light switches to amber!");
            currentState = 3;
            return;
        }
        if (currentState === 3) {
            console.log("Car traffic light switches to red!");
            currentState = 0;
            notify = 1; // Tell pedestrian light to switch to green.
            return;
        }
    =}
}

reactor PedestrianTrafficLight {
    input notify: number  // 0 --> green 1 --> red
    state currentState: number = 1
    
    reaction(startup) {=
        console.log("Pedestrian traffic light is green.");
    =}

    reaction(notify) {=
        if (notify === 1 && currentState === 0) {
            console.log("Pedestrian traffic light switches to green!");
            currentState = 1;
            return;
        }
        if (notify === 0 && currentState === 1) {
            console.log("Pedestrian traffic light switches to red!");
            currentState = 0;
            return;
        }
    =}
}
